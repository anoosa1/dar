{
  "name": "dar-spacetime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24.22.1 <25" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p module/tsconfig.json",
    "test": "node --test test/*.test.ts",
    "build:module": "node scripts/build-module.mjs",
    "build:client": "node scripts/build-client.mjs",
    "dev": "node scripts/dev.mjs",
    "serve": "node scripts/dev.mjs --production",
    "operator": "node scripts/operator.ts",
    "verify": "node scripts/verify.mjs",
    "start": "node runtime/main.ts"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.8",
    "jose": "6.2.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "spacetimedb": "2.14.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
