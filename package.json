{
  "name": "dar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#dar-notes/contracts": "./src/main/dar/generated/dar-notes/contracts.js",
    "#dar-notes/files": "./src/main/dar/generated/dar-notes/files.js",
    "#dar-notes/reconcile": "./src/main/dar/generated/dar-notes/reconcile.js",
    "#dar-notes/index": "./src/main/dar/generated/dar-notes/index.js",
    "#dar-notes/engine": "./src/main/dar/generated/dar-notes/engine.js",
    "#dar-notes/http": "./src/main/dar/generated/dar-notes/http.js",
    "#dar-notes/assistant": "./src/main/dar/generated/dar-notes/assistant.js",
    "#dar-files/engine": "./src/main/dar/generated/dar-files/engine.js",
    "#dar-files/content": "./src/main/dar/generated/dar-files/content.js",
    "#dar-files/contracts": "./src/main/dar/generated/dar-files/contracts.js",
    "#dar-files/http": "./src/main/dar/generated/dar-files/http.js",
    "#dar-files/dav": "./src/main/dar/generated/dar-files/dav.js",
    "#dar-files/assistant": "./src/main/dar/generated/dar-files/assistant.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build:typescript && npm run build:css && shadow-cljs release server client",
    "build:server": "npm run build:typescript && shadow-cljs release server",
    "build:client": "npm run build:typescript && npm run build:css && shadow-cljs release client",
    "build:typescript": "tsc && tsc -p tsconfig.notes.json && cp src/typescript/files/package.json src/main/dar/generated/dar-files/package.json && cp src/typescript/notes/package.json src/main/dar/generated/dar-notes/package.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.notes.json --noEmit",
    "build:css": "tailwindcss -i src/main/dar/client/styles.css -o public/assets/app.css --minify",
    "compile": "npm run build:typescript && shadow-cljs compile server client test",
    "start": "node dist/server/main.js",
    "test": "npm run build:typescript && shadow-cljs compile test && node --require ./test/helpers/unit-exit-guard.cjs dist/test/tests.cjs",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@cordisjs/plugin-logger-console": "1.0.0",
    "@cordisjs/plugin-server": "1.7.0",
    "cordis": "4.0.0-rc.8",
    "feedsmith": "2.9.6",
    "ical.js": "2.2.1",
    "nodemailer": "10.2.1",
    "openid-client": "6.8.7",
    "postal-mime": "4.1.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.18.1",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "undici": "8.12.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "shadow-cljs": "3.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
